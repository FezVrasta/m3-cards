{
  "name": "m3-cards",
  "version": "2.3.0",
  "description": "Material 3 style Lovelace cards for Home Assistant \u2014 36 cards across energy, climate, light and media, household and safety \u2014 built natively with Lit, with no button-card or card-mod dependency.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && bash scripts/deploy.sh",
    "check": "tsc --noEmit && eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contrast": "esbuild src/shared/contrast.ts --format=esm --outfile=.contrast.mjs --log-level=error && node test/contrast.test.mjs $PWD/.contrast.mjs; rm -f .contrast.mjs"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "climate"
  ],
  "license": "MIT",
  "author": "j0sp0r",
  "repository": {
    "type": "git",
    "url": "https://github.com/j0sp0r/m3-cards.git"
  },
  "homepage": "https://github.com/j0sp0r/m3-cards",
  "bugs": "https://github.com/j0sp0r/m3-cards/issues",
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.0.0"
  }
}
